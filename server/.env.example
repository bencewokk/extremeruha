# App
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/bridal

# Public site address. Used to build the Google OAuth redirect URI shown in
# /admin. Optional: if empty it is detected from the request.
PUBLIC_URL=https://extremeruha.hu

# Admin authentication
# Generate new values with: npm run admin:password
ADMIN_USERNAME=admin
# Use either ADMIN_PASSWORD (local dev) or ADMIN_PASSWORD_HASH (recommended)
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Cloudinary image storage
# Optional fallback: the owner can set these in /admin → Képtárhely instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Calendar API (OAuth2 refresh-token flow)
# Optional fallback: the owner can connect his own Google account in
# /admin → Foglalások (Google Naptár) instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Europe/Budapest

# Google Places API (public reviews)
# Use the Place ID from your Google Business / Google Maps listing.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_REVIEW_LANGUAGE=hu
